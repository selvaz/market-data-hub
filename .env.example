# Copy values into Windows user environment variables; do not commit a real .env.
#
# PowerShell examples:
#   setx FRED_API_KEY "your-fred-key"
#   setx MARKET_DATA_DB "market_data.duckdb"
#   setx MARKET_DATA_REPORT_DIR "reports"
#   setx TELEGRAM_BOT_TOKEN "123456:ABC..."
#   setx TELEGRAM_CHAT_ID "123456789"

FRED_API_KEY=
MARKET_DATA_DB=market_data.duckdb
MARKET_DATA_REPORT_DIR=reports
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# F08 official sovereign yields (free registrations, see docs/f08-sovereign-yields.md).
# Never put credential values in YAML. These names are read at fetch time.
# Optional keyed JSON adapter only; France TEC10 now uses the public CSV (no key).
WEBSTAT_API_KEY=
ECOS_API_KEY=
# These three remain unavailable pending verified daily government series/endpoints.
BANXICO_API_TOKEN=
EVDS_API_KEY=
BCCH_API_TOKEN=
